{
  "name": "telegram-agent-relay",
  "version": "0.1.1",
  "description": "Two-way walkie-talkie connecting Telegram to local AI agent sessions (Orca, Claude, Codex, OpenCode, tmux, cmux)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "telegram-agent-relay": "./bin/agentrelay.js",
    "tg-agent-relay": "./bin/agentrelay.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renatocassino/telegram-agent-relay.git"
  },
  "keywords": [
    "ai",
    "agent",
    "telegram",
    "orca",
    "claude",
    "codex",
    "opencode",
    "tmux",
    "cmux",
    "walkie-talkie",
    "relay",
    "bridge"
  ],
  "author": "Renato Cassino",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build index.ts --target=node --outdir dist",
    "prepublishOnly": "bun run build && bun test",
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "test": "bun test",
    "start:node": "node index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
