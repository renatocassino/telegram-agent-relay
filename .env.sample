# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
ALLOWED_CHAT_ID=123456789
ALLOWED_USER_ID=123456789

# Terminal multiplexer backend: "orca" (default), "tmux", or "cmux"
# TERMINAL_BACKEND=orca

# Specific coordinator or target terminal handle/pane (optional - auto-detected if omitted)
# TARGET_ID=term_2647b33c-faa3-4be1-9e33-1eeee1acd473

# Orca CLI binary (optional - auto-detected: "orca" on macOS, "orca-ide" on Linux/WSL)
# ORCA_BIN=orca-ide

# Node only: per-attempt IPv6/IPv4 connect timeout in ms (default 1000; fixes ETIMEDOUT on WSL)
# NETWORK_FAMILY_TIMEOUT_MS=1000
